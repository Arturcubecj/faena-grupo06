<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Tarea2" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/color_primario</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/color_acento</item>
    </style>

    <style name="Theme.Tarea2" parent="Base.Theme.Tarea2" />
    <!-- Etiquetas de la pantalla de registro -->
    <style name="EtiquetaRegistro">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textColor">@color/color_texto_oscuro</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    
    <!-- Toolbar: texto e íconos blancos sobre el color primario -->
    <style name="ThemeOverlay.FAENA.Toolbar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@color/white</item>
    </style>

    <!-- Título de las ventanas modales -->
    <style name="TituloModal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/color_primario</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Texto normal de las ventanas modales -->
    <style name="TextoModal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/color_texto_oscuro</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Botón principal de la app -->
    <style name="BotonFAENA">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_boton</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    
</resources>